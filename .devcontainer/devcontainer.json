{
  "name": "TypeScript Katas Starter",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "toolchain"
  },
  "postCreateCommand": "mise trust && bun install",
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "EditorConfig.EditorConfig"
      ]
    },
    "jetbrains": {
      "backend": "WebStorm"
    }
  }
}
